{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TrackMLN Installer",
  "version": "1.2.2",
  "identifier": "com.trackmln.installer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1421",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TrackMLN Installer",
        "width": 700,
        "height": 520,
        "minWidth": 560,
        "minHeight": 440,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": ["icons/icon.ico"],
    "resources": ["assets/app"],
    "publisher": "Melogne Studio",
    "copyright": "© 2026 Melogne Studio"
  }
}
